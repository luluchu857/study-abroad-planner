{
  "mcpServers": {
    "liuxue-info-query": {
      "type": "http",
      "url": "https://hi.xwoork.cn/info/mcp",
      "x-workbuddy": {
        "displayName": {
          "zh": "留学信息查询",
          "en": "Study Abroad Information"
        },
        "description": {
          "zh": "查询院校、专业、匿名案例与申请参考信息。",
          "en": "Search programs and anonymous admission evidence."
        }
      }
    },
    "liuxue-application-helper": {
      "type": "http",
      "url": "https://hi.xwoork.cn/assist/mcp",
      "headers": {
        "Authorization": "Bearer ${LIUXUE_API_KEY}"
      },
      "x-workbuddy": {
        "displayName": {
          "zh": "留学申请助手",
          "en": "Study Abroad Application Helper"
        },
        "description": {
          "zh": "个人授权后查看材料、文书与时间线辅助。",
          "en": "Application preparation with a personal API key."
        },
        "auth": {
          "type": "token",
          "tokenSchema": {
            "title": {
              "zh": "配置个人 API Key",
              "en": "Configure your API key"
            },
            "fields": [
              {
                "key": "LIUXUE_API_KEY",
                "label": {
                  "zh": "个人 API Key",
                  "en": "Personal API key"
                },
                "type": "password",
                "required": true
              }
            ]
          }
        }
      }
    }
  }
}
